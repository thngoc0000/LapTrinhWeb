@model OrderViewInfo
@using SV22T1020261.Models.Sales
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    var details = ViewBag.ListDetails as List<OrderDetailViewInfo>;

    decimal sumPrice = 0;
}

@section PageToolBar {
    <div class="btn-group">
        <button type="button"
                class="btn btn-primary dropdown-toggle"
                data-bs-toggle="dropdown">
            <i class="bi bi-gear me-1"></i>
            Xử lý đơn hàng
        </button>
        <ul class="dropdown-menu">
        @{
            var id = Model.OrderID;

            switch (Model.Status)
            {
                case OrderStatusEnum.New:
                    <li>
                        <a class="dropdown-item open-modal"
                           href="~/Order/Accept?id=@id">
                            Duyệt đơn hàng
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item text-danger open-modal"
                           href="~/Order/Reject?id=@id">
                            Từ chối đơn hàng
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item text-danger open-modal"
                           href="~/Order/Cancel?id=@id">
                            Hủy đơn hàng
                        </a>
                    </li>
                    break;

                case OrderStatusEnum.Accepted:
                    <li>
                        <a class="dropdown-item open-modal"
                           href="~/Order/Shipping?orderID=@id">
                            Chuyển giao hàng
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item text-danger open-modal"
                           href="~/Order/Cancel?id=@id">
                            Hủy đơn hàng
                        </a>
                    </li>
                    break;

                case OrderStatusEnum.Shipping:
                    <li>
                        <a class="dropdown-item open-modal"
                           href="~/Order/Finish?id=@id">
                            Hoàn tất đơn hàng
                        </a>
                    </li>
                    break;

                default:
                    <li class="dropdown-item text-muted">
                        Không có thao tác khả dụng
                    </li>
                    break;
            }
        }
        </ul>
    </div>

    @if (Model.Status == OrderStatusEnum.New
       || Model.Status == OrderStatusEnum.Accepted)
    {
        <a asp-controller="Order"
               asp-action="Delete"
               asp-route-orderID="@Model.OrderID"
               class="btn btn-danger ms-1 open-modal">
            <i class="bi bi-trash"></i>
            Xóa
        </a>
    }

    <a href="~/Order" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<!-- TRẠNG THÁI ĐƠN HÀNG -->
@{
    string alertClass = "alert-secondary";
    string iconClass = "bi-info-circle-fill";
    string statusText = "";
    string timeText = "";

    switch (Model.Status)
    {
        case OrderStatusEnum.New:
            alertClass = "alert-primary";
            iconClass = "bi-clock-history";
            statusText = "Đơn hàng mới";
            timeText = $"Được tạo lúc {Model.OrderTime:dd/MM/yyyy HH:mm}";
            break;

        case OrderStatusEnum.Accepted:
            alertClass = "alert-info";
            iconClass = "bi-check-circle-fill";
            statusText = "Đã duyệt";
            timeText = $"Duyệt lúc {Model.AcceptTime:dd/MM/yyyy HH:mm}";
            break;

        case OrderStatusEnum.Shipping:
            alertClass = "alert-warning";
            iconClass = "bi-truck";
            statusText = "Đang giao hàng";
            timeText = $"Bắt đầu giao lúc {Model.ShippedTime:dd/MM/yyyy HH:mm}";
            break;

        case OrderStatusEnum.Completed:
            alertClass = "alert-success";
            iconClass = "bi-patch-check-fill";
            statusText = "Hoàn tất";
            timeText = $"Hoàn tất lúc {Model.FinishedTime:dd/MM/yyyy HH:mm}";
            break;

        case OrderStatusEnum.Cancelled:
            alertClass = "alert-dark";
            iconClass = "bi-x-circle-fill";
            statusText = "Đã hủy";
            break;

        case OrderStatusEnum.Rejected:
            alertClass = "alert-danger";
            iconClass = "bi-slash-circle-fill";
            statusText = "Bị từ chối";
            break;
    }
}

<div class="alert @alertClass d-flex align-items-center mb-3">
    <i class="bi @iconClass fs-4 me-3"></i>
    <div>
        <strong>Trạng thái đơn hàng:</strong>
        <span class="fw-bold">@statusText</span>
        @if (!string.IsNullOrEmpty(timeText))
        {
            <div class="small mt-1">@timeText</div>
        }
    </div>
</div>

<!-- THÔNG TIN ĐƠN HÀNG -->
<div class="card card-primary card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-receipt me-2"></i>
            Thông tin đơn hàng
        </h5>
    </div>

    <div class="card-body ps-4 pe-4">
        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Mã đơn hàng</div>
            <div class="col-md-3">@Model.OrderID</div>

            <div class="col-md-3 fw-bold">Ngày lập</div>
            <div class="col-md-3">@Model.OrderTime</div>
        </div>

        <div class="row">
            <div class="col-md-3 fw-bold">Nhân viên phụ trách</div>
            <div class="col-md-3">@Model.EmployeeName</div>

            <div class="col-md-3 fw-bold">Ngày nhận đơn</div>
            <div class="col-md-3">@Model.AcceptTime</div>
        </div>
    </div>
</div>

<!-- THÔNG TIN KHÁCH HÀNG -->
<div class="card card-info card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-person me-2"></i>
            Thông tin khách hàng
        </h5>
    </div>

    <div class="card-body ps-4 pe-4">
        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Khách hàng</div>
            <div class="col-md-3">@Model.CustomerName</div>

            <div class="col-md-3 fw-bold">Tên giao dịch</div>
            <div class="col-md-3">@Model.CustomerContactName</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Email</div>
            <div class="col-md-9">@Model.CustomerEmail</div>
        </div>

        <div class="row">
            <div class="col-md-3 fw-bold">Địa chỉ</div>
            <div class="col-md-9">@Model.CustomerAddress</div>
        </div>
    </div>
</div>

<!-- THÔNG TIN GIAO HÀNG -->
<div class="card card-success card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-truck me-2"></i>
            Thông tin giao hàng
        </h5>
    </div>

    <div class="card-body ps-4 pe-4">
        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Người giao hàng</div>
            <div class="col-md-3">@Model.ShipperName</div>

            <div class="col-md-3 fw-bold">Điện thoại</div>
            <div class="col-md-3">@Model.ShipperPhone</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Địa chỉ giao hàng</div>
            <div class="col-md-9">@Model.DeliveryAddress</div>
        </div>

        <div class="row">
            <div class="col-md-3 fw-bold">Tỉnh / Thành</div>
            <div class="col-md-9">@Model.DeliveryProvince</div>
        </div>
    </div>
</div>

<!-- DANH SÁCH MẶT HÀNG -->
<div class="card card-secondary card-outline">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-box-seam me-2"></i>
            Danh sách mặt hàng
        </h5>
    </div>

    <div class="card-body table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-secondary text-center">
                <tr>
                    <th>STT</th>
                    <th>Tên hàng</th>
                    <th>ĐVT</th>
                    <th>Số lượng</th>
                    <th>Giá</th>
                    <th>Thành tiền</th>
                    <th style="width:90px"></th>
                </tr>
            </thead>
            <tbody>
                @if (details != null && details.Count > 0)
                {
                    int i = 1;
                    foreach (var item in details)
                    {
                        sumPrice += item.TotalPrice;
                        <tr>
                            <td class="text-center">@i</td>
                            <td>
                                @item.ProductName
                            </td>
                            <td class="text-center">
                                @item.Unit
                            </td>
                            <td class="text-center">
                                @item.Quantity
                            </td>
                            <td class="text-end">
                                @item.SalePrice.ToString("N0")
                            </td>
                            <td class="text-end">
                                @item.TotalPrice.ToString("N0")
                            </td>
                            <td class="text-end">
                                @if (Model.Status == OrderStatusEnum.New
                                        || Model.Status == OrderStatusEnum.Accepted)
                                {
                                    <a asp-controller="Order"
                                            asp-action="EditCartItem"
                                            asp-route-orderID="@item.OrderID"
                                            asp-route-productId="@item.ProductID"
                                            class="btn btn-sm btn-primary open-modal">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-controller="Order"
                                            asp-action="DeleteCartItem"
                                            asp-route-orderID="@item.OrderID"
                                            asp-route-productId="@item.ProductID"
                                            class="btn btn-sm btn-danger open-modal">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Không khả dụng</span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Chưa có mặt hàng nào trong đơn hàng
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Tổng cộng</th>
                    <th class="text-end">@sumPrice.ToString("N0") đ</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .card-body .row {
            border-bottom: 1px dotted #646464;
        }
    </style>
    <script>
        function updateCartItem(event, form) {
            event.preventDefault();

            const formData = new FormData(form);

            fetch('/Order/UpdateCartItem', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(result => {

                if (result.code === 0) {
                    // Hiển thị lỗi trong modal
                    const errorBox = document.getElementById("modal-error");
                    if (errorBox) {
                        errorBox.innerText = result.message;
                        errorBox.classList.remove("d-none");
                    } else {
                        alert(result.message);
                    }
                    return;
                }

                // Đóng modal Bootstrap 5
                const modalElement = document.getElementById('dialogModal');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                if (modalInstance) {
                    modalInstance.hide();
                }

                // Reload lại giỏ hàng
                location.reload();

            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Không thể cập nhật đơn hàng.');
            });
        }
        // function deleteCartItem(orderID, productID) {

        //     fetch(`/Order/DeleteCartItem?productId=${productID}&&orderID=${orderID}`, {
        //         method: 'POST'
        //     })
        //     .then(response => {
        //         if (!response.ok) {
        //             throw new Error('Network response was not ok');
        //         }
        //         return response.json(); nếu API trả JSON
        //     })
        //     .then(result => {
        //         nếu API có trả code/message thì có thể kiểm tra ở đây
        //         còn nếu không cần thì gọi luôn
        //         location.reload();
        //     })
        //     .catch(error => {
        //         console.error('Lỗi:', error);
        //         alert('Không thể xóa sản phẩm khỏi giỏ hàng.');
        //     });
        // }
        function deleteCartItem(orderID, productID) {

            fetch(`/Order/DeleteCartItem?productId=${productID}&orderID=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {

                // ❌ Lỗi
                if (data.code == 0) {
                    alert(data.message);
                    return;
                }

                // ✅ Hết sản phẩm → đơn hàng bị xóa
                if (data.code == 2) {
                    if (data.message)
                        alert(data.message);

                    window.location.href = "/Order/Index";
                    return;
                }

                // ✅ Còn sản phẩm → reload
                location.reload();
            })
            .catch(error => {
                alert("Có lỗi xảy ra khi xóa dữ liệu!");
                console.error(error);
            });
        }
        function deleteOrder(orderID) {
            fetch(`/Order/Delete?orderID=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {

                // Nếu lỗi
                if (data.code == 0) {
                    alert(data.message || "Xoá đơn hàng thất bại!");
                    return;
                }

                // Thành công → chuyển hướng
                window.location.href = "/Order/Index";
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xoá đơn hàng!");
            });
        }
        function acceptOrder(orderID) {
            fetch(`/Order/Accept?id=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.code == 0) {
                    alert(data.message || "Duyệt đơn hàng thất bại!");
                    return;
                }

                // Thành công → reload lại trang
                location.reload();
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xử lý đơn hàng!");
            });
        }
        function shippingOrder(event, form) {
            event.preventDefault(); // chặn submit mặc định

            const formData = new FormData(form);

            fetch("/Order/Shipping", {
                method: "POST",
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.code == 0) {
                    alert(data.message || "Chuyển giao hàng thất bại!");
                    return;
                }

                // Thành công → reload trang
                location.reload();
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xử lý!");
            });
        }
        function finishOrder(orderID) {
            fetch(`/Order/Finish?id=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.code == 0) {
                    alert(data.message || "Hoàn thành đơn hàng thất bại!");
                    return;
                }

                // Thành công → reload lại trang
                location.reload();
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xử lý đơn hàng!");
            });
        }
        function rejectOrder(orderID) {
            fetch(`/Order/Reject?id=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.code == 0) {
                    alert(data.message || "Từ chối đơn hàng thất bại!");
                    return;
                }

                // Thành công → reload lại trang
                location.reload();
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xử lý đơn hàng!");
            });
        }
        function cancelOrder(orderID) {
            fetch(`/Order/Cancel?id=${orderID}`, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.code == 0) {
                    alert(data.message || "Huỷ đơn hàng thất bại!");
                    return;
                }

                // Thành công → reload lại trang
                location.reload();
            })
            .catch(error => {
                console.error(error);
                alert("Có lỗi xảy ra khi xử lý đơn hàng!");
            });
        }
    </script>
}