@model List<Cart>
@{
    ViewBag.Title = "Giỏ hàng của bạn";
    decimal total = 0;
}

@if (Model == null || !Model.Any())
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 text-center">

                <div class="card border-0 shadow-sm rounded-4 p-5">
                    
                    <div class="mb-4">
                        <i class="bi bi-cart-x text-muted" style="font-size: 80px;"></i>
                    </div>

                    <h4 class="fw-bold mb-3">Giỏ hàng của bạn đang trống</h4>

                    <p class="text-muted mb-4">
                        Hãy thêm sản phẩm vào giỏ để tiếp tục mua sắm nhé!
                    </p>

                    <a href="@Url.Action("Index", "Home")"
                           class="btn btn-primary btn-lg rounded-3 fw-bold px-4">
                        <i class="bi bi-bag-plus me-2"></i>
                        Tiếp tục mua sắm
                    </a>

                </div>

            </div>
        </div>
    </div>
}
else
{
    
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold m-0"><i class="bi bi-cart3"></i> Giỏ hàng của bạn</h2>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 p-3">Sản phẩm</th>
                                    <th class="border-0 p-3 text-center">Đơn giá</th>
                                    <th class="border-0 p-3 text-center">Số lượng</th>
                                    <th class="border-0 p-3 text-center">Thành tiền</th>
                                    <th class="border-0 p-3 text-center"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    total += item.Price * item.Quantity;
                                    <tr>
                                        <td class="p-3">
                                            <div class="d-flex align-items-center">
                                                <img src="~/images/products/@(string.IsNullOrEmpty(item.Photo) ? "nophoto.png" : item.Photo)"
                                                     class="rounded-3 me-3"
                                                     style="width:120px; height:120px; object-fit:cover;"
                                                     alt="Product">
                                                <div>
                                                    <h6 class="fw-bold mb-0">@item.ProductName</h6>
                                                    <small class="text-muted">@item.CategoryName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-3 text-center text-primary fw-bold">@item.Price.ToString("N0")đ</td>
                                            <td class="p-3 text-center" style="min-width: 150px;">
                                                <form asp-action="Update" asp-controller="Cart" method="post" class="d-flex justify-content-center">
        
                                                    <input type="hidden" name="ProductID" value="@item.ProductID" />

                                                    <div class="input-group input-group-sm" style="max-width:150px;">

                                                        <!-- Nút - -->
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                onclick="decrease(this)">
                                                            -
                                                        </button>

                                                        <!-- Input -->
                                                        <input type="number"
                                                               name="Quantity"
                                                               value="@item.Quantity"
                                                               min="1"
                                                               class="form-control text-center"
                                                               onchange="this.form.submit()" />

                                                        <!-- Nút + -->
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                onclick="increase(this)">
                                                            +
                                                        </button>

                                                    </div>
                                                </form>
                                            </td>
                                        <td class="p-3 text-center fw-bold text-dark">@((item.Price * item.Quantity).ToString("N0"))đ</td>
                                        <td class="p-3 text-center">
                                            <a href="@Url.Action("Remove","Cart", new { id = item.ProductID})" class="btn btn-outline-danger btn-sm border-0" title="Xóa mặt hàng"
                                                       onclick="return confirm('Bạn có chắc chắn muốn xóa không?')">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                                
                            </tbody>
                        </table>
                    </div>
                
                    <div class="card-footer bg-white p-3 border-0 border-top">
                        <a href="@Url.Action("Clear","Cart")" class="btn btn-link text-danger text-decoration-none btn-sm fw-bold" 
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa giỏ hàng không?')">
                            <i class="bi bi-x-circle"></i> Xoá toàn bộ giỏ hàng
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-2">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">Thông tin đơn hàng</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-bold">@(total.ToString("N0"))đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <hr class="my-4 border-dashed">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold">Tổng cộng:</span>
                                <span class="fs-4 fw-bolder text-primary">@(total.ToString("N0"))đ</span>
                        </div>
                    
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Checkout","Cart")"
                                    class="btn btn-primary btn-lg rounded-3 fw-bold">
                                <i class="bi bi-credit-card"></i> THANH TOÁN NGAY
                            </a>
                        </div>
                    
                        <div class="mt-4 p-3 bg-light rounded-3">
                            <p class="small text-muted mb-0">
                                <i class="bi bi-shield-check"></i> Cam kết bảo mật thông tin thanh toán của khách hàng.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
    <script>
        function increase(btn) {
            var input = btn.parentElement.querySelector("input[name='Quantity']");
            input.value = parseInt(input.value) + 1;
            btn.closest("form").submit();
        }

        function decrease(btn) {
            var input = btn.parentElement.querySelector("input[name='Quantity']");
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
                btn.closest("form").submit();
            }
        }
    </script>