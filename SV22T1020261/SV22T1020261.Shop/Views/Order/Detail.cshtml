@model List<OrderDetailViewInfo>
@{
    ViewBag.Title = "Chi tiết đơn hàng";

    var order = ViewBag.Order as OrderViewInfo;

    decimal totalAmount = 0;
}

<div class="container py-5">
    <div class="mb-4">
        <a href="javascript:history.back()" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left"></i> Quay lại trang trước
        </a>
        <div class="d-flex align-items-center mt-2">
            <h2 class="fw-bold m-0">Chi tiết đơn hàng <span class="text-primary">#@order.OrderID</span></h2>
            @{
                string badgeClass = "", badgeText = "";
                switch (order.Status)
                {
                    case OrderStatusEnum.New:
                        badgeClass = "bg-secondary";
                        badgeText = "Đơn đang chờ xử lý";
                        break;

                    case OrderStatusEnum.Accepted:
                        badgeClass = "bg-primary";
                        badgeText = "Đơn đã được xác nhận";
                        break;

                    case OrderStatusEnum.Shipping:
                        badgeClass = "bg-warning";
                        badgeText = "Shipper đang giao hàng";
                        break;

                    case OrderStatusEnum.Completed:
                        badgeClass = "bg-success";
                        badgeText = "Giao hàng thành công";
                        break;

                    case OrderStatusEnum.Cancelled:
                        badgeClass = "bg-danger";
                        badgeText = "Đơn đã bị hủy";
                        break;

                    case OrderStatusEnum.Rejected:
                        badgeClass = "bg-danger";
                        badgeText = "Đơn đã bị từ chối";
                        break;
                }
            }
            <span class="badge @badgeClass rounded-pill ms-3 px-3 py-2">
                @badgeText
            </span>
        </div>
    </div>

    <div class="row g-4">
        @if (order != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark">
                            <i class="bi bi-info-circle me-2 text-primary"></i>1. Thông tin đơn hàng
                        </h5>
                        <div class="row mb-3">
                            <div class="col-5 text-muted">Ngày đặt hàng:</div>
                            <div class="col-7 fw-medium text-warning">@order.OrderTime</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 text-muted">Địa chỉ:</div>
                            <div class="col-7 fw-medium">@order.CustomerAddress</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark">
                            <i class="bi bi-truck me-2 text-primary"></i>2. Thông tin giao hàng
                        </h5>
                        <div class="row mb-3">
                            <div class="col-5 text-muted">Người giao hàng:</div>
                            <div class="col-7 fw-medium">@(string.IsNullOrEmpty(order.ShipperName) ? "Chưa xác định" : order.ShipperName)</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 text-muted">Số điện thoại:</div>
                            <div class="col-7 fw-medium">@(string.IsNullOrEmpty(order.ShipperPhone) ? "Chưa xác định" : order.ShipperPhone)</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 text-muted">Ngày giao:</div>
                            <div class="col-7 fw-medium text-success">@(order.ShippedTime != null ? order.ShippedTime : "Chưa xác định")</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-2">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold m-0"><i class="bi bi-list-ul me-2 text-primary"></i>3. Danh sách mặt hàng</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 border-0 text-muted small text-uppercase py-3">Sản phẩm</th>
                                <th class="border-0 text-muted small text-uppercase py-3 text-center">Đơn giá</th>
                                <th class="border-0 text-muted small text-uppercase py-3 text-center">Số lượng</th>
                                <th class="pe-4 border-0 text-muted small text-uppercase py-3 text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                totalAmount += item.TotalPrice;
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <img src="~/images/products/@(string.IsNullOrEmpty(item.Photo) ? "nophoto.png" : item.Photo)"
                                                  class="rounded-3 me-3"
                                                  style="width:120px; height:120px; object-fit:cover;"
                                                  alt="Product">
                                            <div>
                                                <h6 class="fw-bold mb-0">@item.ProductName</h6>
                                                @* <small class="text-muted text-uppercase" style="font-size: 0.7rem;">Màu: Starlight | RAM: 8GB</small> *@
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-medium">@item.SalePrice.ToString("N0") đ</td>
                                    <td class="text-center fw-medium">@item.Quantity</td>
                                        <td class="pe-4 text-end fw-bold text-dark">@item.TotalPrice.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light-subtle border-top">
                            <tr>
                                <td colspan="3" class="text-end py-3 ps-4 fs-5 fw-bold border-0">Tổng thanh toán:</td>
                                    <td class="pe-4 py-3 text-end fs-5 fw-bolder text-primary border-0">@totalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>