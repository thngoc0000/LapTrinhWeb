@{
    ViewBag.Title = "Lịch sử mua hàng";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history text-secondary"></i> Lịch sử mua hàng</h2>
            <p class="text-muted mb-0">Xem lại các đơn hàng bạn đã hoàn tất trong quá khứ.</p>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm rounded-3" style="width: auto;">
                <option>Tất cả thời gian</option>
                <option>Tháng này</option>
                <option>Năm 2025</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm rounded-3">
                <i class="bi bi-download"></i> Xuất báo cáo
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-bold small text-uppercase">Mã đơn hàng</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Thời gian đặt</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Thời gian hoàn thành</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Người giao hàng</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Địa chỉ giao</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Thành tiền</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-dark">#DH-8829</span>
                        </td>
                        <td>
                            <div class="small">15/02/2026</div>
                            <div class="text-muted min-small" style="font-size: 0.75rem;">14:30</div>
                        </td>
                        <td>
                            <div class="small text-success fw-medium">17/02/2026</div>
                            <div class="text-muted min-small" style="font-size: 0.75rem;">09:15</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                    <i class="bi bi-person-badge text-secondary"></i>
                                </div>
                                <span class="small">Nguyễn Văn A</span>
                            </div>
                        </td>
                        <td>
                            <p class="small mb-0 text-truncate" style="max-width: 150px;" title="45 Phan Bội Châu, Quận 1, TP. HCM">
                                45 Phan Bội Châu, <strong>TP. HCM</strong>
                            </p>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">12.500.000đ</span>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="viewHistoryDetail('8829')">
                                <i class="bi bi-eye"></i> Chi tiết
                            </button>
                        </td>
                    </tr>

                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-dark">#DH-7712</span>
                        </td>
                        <td>
                            <div class="small">10/01/2026</div>
                        </td>
                        <td>
                            <div class="small text-success fw-medium">12/01/2026</div>
                        </td>
                        <td>
                            <span class="small">Trần Thị B</span>
                        </td>
                        <td>
                            <p class="small mb-0 text-truncate" style="max-width: 150px;">
                                12 Láng Hạ, <strong>Hà Nội</strong>
                            </p>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">2.450.000đ</span>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="viewHistoryDetail('7712')">
                                <i class="bi bi-eye"></i> Chi tiết
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="card-footer bg-white py-3 border-0">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item disabled"><a class="page-link rounded-start-3" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link rounded-end-3" href="#">Sau</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    function viewHistoryDetail(orderId) {
        alert("Đang tải chi tiết đơn hàng cũ mã: " + orderId);
    }
</script>