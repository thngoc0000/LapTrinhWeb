@model List<OrderViewInfo>
@{
    ViewBag.Title = "Theo dõi đơn hàng";

}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="bi bi-box-seam"></i> Đơn hàng của tôi</h2>
        @* <div class="btn-group">
            <button class="btn btn-outline-primary active btn-sm rounded-start-3 px-3">Đang xử lý</button>
            <button class="btn btn-outline-secondary btn-sm rounded-end-3 px-3">Lịch sử đơn hàng</button>
        </div> *@
    </div>

    <div class="row g-4">
        @foreach (var order in Model)
        {
            if(order.Status == OrderStatusEnum.Rejected || order.Status == OrderStatusEnum.Cancelled)
            {
                
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden opacity-75">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <div class="row align-items-center text-muted">
                                <div class="col-md-3">Mã: <strong>@order.OrderID</strong></div>
                                <div class="col-md-3">Ngày: @order.OrderTime</div>
                                <div class="col-md-4 text-truncate">@order.DeliveryAddress, <strong>@order.DeliveryProvince</strong></div>
                                <div class="col-md-2 text-md-end">
                                    <button class="btn btn-sm btn-outline-secondary rounded-3">Xem lại</button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i> @(order.Status == OrderStatusEnum.Rejected ? "Bị từ chối" : "Đã hủy"))
                                    </span>
                                    @* <span class="ms-3 text-muted small italic">Lý do: Hết hàng trong kho</span> *@
                                </div>
                                <h6 class="mb-0 fw-bold">@order.TotalAmount.ToString("NO") VNĐ</h6>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-12">
                    @{
                        int currentStep = (int)order.Status;

                        string GetStepBg(int step)
                        {
                            return step <= currentStep
                                ? "bg-primary text-white shadow"
                                : "bg-light text-muted border";
                        }

                        string GetTextClass(int step)
                        {
                            return step <= currentStep
                                ? "fw-bold text-primary"
                                : "text-muted";
                        }

                        string badgeClass = "";
                        string badgeText = "";

                        switch (order.Status)
                        {
                            case OrderStatusEnum.New:
                                badgeClass = "bg-secondary-subtle text-secondary";
                                badgeText = "Đơn đang chờ xử lý";
                                break;

                            case OrderStatusEnum.Accepted:
                                badgeClass = "bg-primary-subtle text-primary";
                                badgeText = "Đơn đã được xác nhận";
                                break;

                            case OrderStatusEnum.Shipping:
                                badgeClass = "bg-warning-subtle text-warning";
                                badgeText = "Shipper đang giao hàng";
                                break;

                            case OrderStatusEnum.Completed:
                                badgeClass = "bg-success-subtle text-success";
                                badgeText = "Giao hàng thành công";
                                break;
                        }
                    }
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <span class="text-muted small d-block">Mã đơn hàng:</span>
                                    <span class="fw-bold text-primary">@order.OrderID</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted small d-block">Ngày đặt:</span>
                                    <span class="fw-medium">
                                        @order.OrderTime.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Địa chỉ giao hàng:</span>
                                    <span class="text-truncate d-inline-block" style="max-width: 100%;">
                                        @order.DeliveryAddress, <strong>@order.DeliveryProvince</strong>
                                    </span>
                                </div>
                                <div class="col-md-2 text-md-end">
                                    <a asp-action="Details" asp-route-id="@order.OrderID"
                                           class="btn btn-sm btn-light border rounded-3 px-3">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">

                            <!-- Timeline -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between position-relative">
                                        <div class="position-absolute top-50 start-0 end-0 border-top"
                                             style="z-index: 0; transform: translateY(-50%);"></div>

                                        <!-- Step 1 -->
                                        <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-1 @GetStepBg(0)"
                                                 style="width: 32px; height: 32px;">
                                                <i class="bi bi-file-earmark-plus small"></i>
                                            </div>
                                            <div class="small d-block @GetTextClass(0)">Vừa gửi</div>
                                        </div>

                                        <!-- Step 2 -->
                                        <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-1 @GetStepBg(1)"
                                                 style="width: 32px; height: 32px;">
                                                <i class="bi bi-check-lg small"></i>
                                            </div>
                                            <div class="small d-block @GetTextClass(1)">Chấp nhận</div>
                                        </div>

                                        <!-- Step 3 -->
                                        <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-1 @GetStepBg(2)"
                                                 style="width: 32px; height: 32px;">
                                                <i class="bi bi-truck small"></i>
                                            </div>
                                            <div class="small d-block @GetTextClass(2)">Đang vận chuyển</div>
                                        </div>

                                        <!-- Step 4 -->
                                        <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-1 @GetStepBg(3)"
                                                 style="width: 32px; height: 32px;">
                                                <i class="bi bi-house-check small"></i>
                                            </div>
                                            <div class="small d-block @GetTextClass(3)">Đã nhận</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment + Status -->
                            <div class="d-flex justify-content-between align-items-end">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary-subtle p-2 rounded-3 me-3">
                                        <i class="bi bi-cash-stack text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <span class="text-muted small">Tổng thanh toán:</span>
                                        <h5 class="fw-bold mb-0 text-danger">
                                            @order.TotalAmount.ToString("N0") VNĐ
                                        </h5>
                                    </div>
                                </div>

                                <div>
                                    <span class="badge @badgeClass rounded-pill px-3 py-2 fw-medium">
                                        <i class="bi bi-info-circle me-1"></i> @badgeText
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }        

    </div>
</div>