@model PagedResult<Product>
@{
    Layout = null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0 h4">Sản phẩm nổi bật</h2>
    <span class="badge text-primary px-3 py-2 rounded-pill shadow-sm" style="background-color: #e7f1ff;">
        Tổng cộng: <strong>@Model.RowCount</strong> sản phẩm
    </span>
</div>
<div class="card">

    <div class="card-body row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-4 mb-5">
        @* <form action="~/Cart/Add" method="post"> *@
        @foreach (var item in Model.DataItems)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                    <div class="ratio ratio-4x3 p-2">
                        <img src="~/images/products/@(string.IsNullOrEmpty(item.Photo) ? "nophoto.png" : item.Photo)"
                             class="img-fluid rounded-4 shadow-sm"
                             alt="@item.ProductName">
                            @* <img src="@item.Photo" class="rounded-4 object-fit-cover shadow-sm" alt="@item.ProductName"> *@
                        </div>
                
                        <div class="card-body d-flex flex-column pt-2">
                            @* <div class="mb-2">
                        <span class="badge bg-light text-muted fw-normal border rounded-pill px-2">Loại: @item.CategoryID</span>
                    </div> *@
                    
                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.ProductName">
                                @item.ProductName
                            </h6>
                    
                            <div class="mt-auto pt-3">
                                <p class="card-text text-primary fw-bolder fs-5 mb-3">
                                    @item.Price.ToString("N0") <small class="fs-6 fw-normal">đ</small>
                                </p>
                        
                                <div class="row g-2">
                                    <div class="col-9">
                                        <a href="@Url.Action("Add", "Cart", new { id = item.ProductID })"
                                               class="btn btn-dark w-100 btn-sm rounded-3 py-2 fw-bold">
                                            <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                        </a>
                                    </div>
                                    <div class="col-3">
                                        <a href="/Home/Detail/@item.ProductID" class="btn btn-outline-secondary w-100 btn-sm rounded-3 py-2">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @* </form> *@
        
        </div>

        <div class="card-footer mt-1 border-top pt-4 d-flex justify-content-center">
            <ul class="pagination mb-0 shadow-sm rounded-3 overflow-hidden">
                @foreach (var p in Model.GetDisplayPages())
                {
                    if (p.IsCurrent)
                    {
                        <li class="page-item active">
                            <span class="page-link border-0 px-4 py-2">@p.Page</span>
                        </li>
                    }
                    else if (p.IsEllipsis)
                    {
                        <li class="page-item disabled">
                            <span class="page-link border-0 px-3 py-2">...</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link border-0 px-4 py-2 text-dark" href="javascript:;"
                                   onclick="paginationSearch(event, document.getElementById('formSearch'), @p.Page)">
                                @p.Page
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>