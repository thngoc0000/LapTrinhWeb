@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="mb-3">
                <a href="@Url.Action("Profile", "Customer")" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left"></i> Quay lại hồ sơ cá nhân
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-sm-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-shield-lock fs-2"></i>
                        </div>
                        <h3 class="fw-bold">Đổi mật khẩu</h3>
                        <p class="text-muted small">Vui lòng nhập mật khẩu hiện tại và mật khẩu mới để bảo mật tài khoản.</p>
                    </div>

                    <form action="/Customer/ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Mật khẩu hiện tại</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-3"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control bg-light border-0 rounded-end-3 shadow-none"
                                       name="CurrentPassword" placeholder="••••••••" required>
                            </div>
                        </div>

                        <hr class="my-4 border-light">

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-3"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control bg-light border-0 rounded-end-3 shadow-none"
                                       name="NewPassword" placeholder="Tối thiểu 6 ký tự" required>
                            </div>
                            <div class="form-text mt-1" style="font-size: 0.75rem;">
                                Gợi ý: Sử dụng kết hợp chữ hoa, chữ thường và số.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small">Xác nhận mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-3"><i class="bi bi-check2-square"></i></span>
                                <input type="password" class="form-control bg-light border-0 rounded-end-3 shadow-none"
                                       name="ConfirmPassword" placeholder="Nhập lại mật khẩu mới" required>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                                Cập nhật mật khẩu
                            </button>
                            <a href="@Url.Action("Profile", "Customer")" class="btn btn-link text-muted text-decoration-none small">
                                Tôi quên mật khẩu hiện tại?
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 p-3 bg-info-subtle rounded-3 border-0">
                <p class="small text-info-emphasis mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Sau khi đổi mật khẩu thành công, bạn có thể cần phải đăng nhập lại trên các thiết bị khác.
                </p>
            </div>
        </div>
    </div>
</div>