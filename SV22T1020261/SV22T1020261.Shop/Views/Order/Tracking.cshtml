@{
    ViewBag.Title = "Theo dõi đơn hàng";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="bi bi-box-seam"></i> Đơn hàng của tôi</h2>
        @* <div class="btn-group">
            <button class="btn btn-outline-primary active btn-sm rounded-start-3 px-3">Đang xử lý</button>
            <button class="btn btn-outline-secondary btn-sm rounded-end-3 px-3">Lịch sử đơn hàng</button>
        </div> *@
    </div>

    <div class="row g-4">
        
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom border-light">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Mã đơn hàng:</span>
                            <span class="fw-bold text-primary">#TECH-2026-001</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Ngày đặt:</span>
                            <span class="fw-medium">28/03/2026</span>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted small d-block">Địa chỉ giao hàng:</span>
                            <span class="text-truncate d-inline-block" style="max-width: 100%;">
                                123 Đường Lê Lợi, <strong>Thành phố Huế</strong>
                            </span>
                        </div>
                        <div class="col-md-2 text-md-end">
                            <button class="btn btn-sm btn-light border rounded-3 px-3" onclick="viewOrderDetails('001')">
                                Xem chi tiết
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between position-relative">
                                <div class="position-absolute top-50 start-0 end-0 border-top" style="z-index: 0; transform: translateY(-50%);"></div>
                                
                                <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-1 shadow" style="width: 32px; height: 32px;">
                                        <i class="bi bi-file-earmark-plus small"></i>
                                    </div>
                                    <div class="small fw-bold d-block">Vừa gửi</div>
                                </div>

                                <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-1 shadow" style="width: 32px; height: 32px;">
                                        <i class="bi bi-check-lg small"></i>
                                    </div>
                                    <div class="small fw-bold d-block">Chấp nhận</div>
                                </div>

                                <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                    <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center mb-1 shadow" style="width: 32px; height: 32px;">
                                        <i class="bi bi-truck small"></i>
                                    </div>
                                    <div class="small fw-bold d-block text-warning">Đang vận chuyển</div>
                                </div>

                                <div class="text-center position-relative bg-white px-2" style="z-index: 1;">
                                    <div class="rounded-circle bg-light text-muted d-inline-flex align-items-center justify-content-center mb-1 border" style="width: 32px; height: 32px;">
                                        <i class="bi bi-house-check small"></i>
                                    </div>
                                    <div class="small text-muted d-block">Đã nhận</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-end">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary-subtle p-2 rounded-3 me-3">
                                <i class="bi bi-cash-stack text-primary fs-4"></i>
                            </div>
                            <div>
                                <span class="text-muted small">Tổng thanh toán:</span>
                                <h5 class="fw-bold mb-0 text-danger">28.990.000 VNĐ</h5>
                            </div>
                        </div>
                        
                        <div>
                            <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2 fw-medium">
                                <i class="bi bi-info-circle me-1"></i> Shipper đang lấy hàng
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden opacity-75">
                <div class="card-header bg-white py-3 border-bottom border-light">
                    <div class="row align-items-center text-muted">
                        <div class="col-md-3">Mã: <strong>#TECH-2026-002</strong></div>
                        <div class="col-md-3">Ngày: 25/03/2026</div>
                        <div class="col-md-4 text-truncate">Quận 1, <strong>TP. Hồ Chí Minh</strong></div>
                        <div class="col-md-2 text-md-end">
                            <button class="btn btn-sm btn-outline-secondary rounded-3" onclick="viewOrderDetails('002')">Xem lại</button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                <i class="bi bi-x-circle me-1"></i> Đã bị hủy
                            </span>
                            <span class="ms-3 text-muted small italic">Lý do: Hết hàng trong kho</span>
                        </div>
                        <h6 class="mb-0 fw-bold">15.200.000 VNĐ</h6>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function viewOrderDetails(id) {
        alert("Chuyển hướng đến chi tiết đơn hàng mã: " + id);
    }
</script>