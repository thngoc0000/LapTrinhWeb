@model OrderSearchInput
@{
    ViewBag.Title = "Lịch sử mua hàng";
}

<div class="container py-5">
    <form id="formSearch"
          method="get"
          action="~/Order/Search"
          data-target="searchResult"
          onsubmit="paginationSearch(event, this, 1)">
          
        <input type="hidden" asp-for="PageSize" />

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h2 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history text-secondary"></i> Lịch sử mua hàng</h2>
                <p class="text-muted mb-0">Xem lại các đơn hàng bạn đã hoàn tất trong quá khứ.</p>
            </div>
            <div class="d-flex gap-2">
                <div class="input-group">
                    <input type="text" asp-for="DateFrom"
                           class="form-control date-picker"
                           placeholder="Từ ngày..." />

                    <span class="input-group-text">-</span>

                    <input type="text" asp-for="DateTo"
                           class="form-control date-picker"
                           placeholder="...đến ngày" />
                </div>
            </div>
            <button class="btn btn-info d-flex align-items-center">
                <i class="bi bi-search me-1"></i>
            </button>
        </div>
    </form>

    <div id="searchResult"></div>
    
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("formSearch"), 1);
        });
    </script>
}