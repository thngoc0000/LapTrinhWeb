@model ProductSearchInput
@{
    ViewBag.Title = "Lập đơn hàng";
}

<div class="row">
    <!-- Tìm kiếm & chọn mặt hàng -->
    <div class="col-4">
        <div class="card card-outline card-primary h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-search"></i>
                    Lựa chọn hàng cần bán
                </h5>
            </div>

            <div class="card-body">
                <!-- Search -->
                <form id="formSearch"
                      method="get"
                      action="~/Order/SearchProduct"
                      data-target="searchResult"
                      onsubmit="paginationSearch(event, this, 1)">

                    <input type="hidden" asp-for="PageSize" />

                    <div class="input-group">
                        <input class="form-control"
                               asp-for="SearchValue"
                               placeholder="Nhập tên mặt hàng cần tìm" autofocus />
                        <button class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>
            <div id="searchResult"></div>

        </div>
    </div>

    <!-- Giỏ hàng và thông tin khách hàng -->
    <div class="col-8">
        <!-- Giỏ hàng -->
        <div class="row">
            <div class="col-12" id="cart">
               
            </div>
        </div>
        <!-- Thông tin khách hàng và nơi giao hàng -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-person"></i>
                            Thông tin khách hàng & nơi giao hàng
                        </h5>
                    </div>

                    <div class="card-body">
                        <form onsubmit="createOrder(event,this)">
                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Khách hàng</label>
                                <div class="col-md-10">
                                    <select class="form-select" name="customerID" asp-items="await SelectListHelper.Customers()">
                                    </select>
                                </div>
                            </div>  

                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Tỉnh/thành</label>
                                <div class="col-md-10">
                                    <select class="form-select" name="province" asp-items="await SelectListHelper.Provinces()">
                                        @* <option value="0">-- Chọn Tỉnh/thành giao hàng --</option> *@
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Địa chỉ</label>
                                <div class="col-md-10">
                                    <textarea class="form-control" name="address"></textarea>
                                </div>
                            </div>

                            <div class="text-end">
                                <button class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i>
                                    Lập đơn hàng
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("formSearch"), @Model.Page);
            showCart();
        });
        function showCart() {
            fetch('/Order/ShowCart', {
                method: 'GET'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.text(); // vì trả về HTML
            })
            .then(data => {
                document.getElementById('cart').innerHTML = data;
            })
            .catch(error => {
                console.error('Lỗi:', error);
                document.getElementById('cart').innerHTML =
                    '<div class="text-danger">Không thể tải giỏ hàng.</div>';
            });
        }
        function addCartItem(event, form) {
            event.preventDefault(); // chặn submit mặc định

            const formData = new FormData(form);

            fetch('/Order/AddCartItem', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(result => {
                if (result.code === 0) {
                    alert(result.message); // hiển thị lỗi
                } else {
                    showCart(); // cập nhật lại giỏ hàng
                }
            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Có lỗi xảy ra, vui lòng thử lại.');
            });
        }
        function deleteCartItem(productID) {

            fetch(`/Order/DeleteCartItem?productId=${productID}`, {
                method: 'POST'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json(); // nếu API trả JSON
            })
            .then(result => {
                // nếu API có trả code/message thì có thể kiểm tra ở đây
                // còn nếu không cần thì gọi luôn
                showCart();
            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Không thể xóa sản phẩm khỏi giỏ hàng.');
            });
        }
        function clearCart() {

            fetch(`/Order/ClearCart`, {
                method: 'POST'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json(); // nếu API trả JSON
            })
            .then(result => {
                // nếu API có trả code/message thì có thể kiểm tra ở đây
                // còn nếu không cần thì gọi luôn
                showCart();
            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Không thể xóa sản phẩm khỏi giỏ hàng.');
            });
        }
        function updateCartItem(event, form) {
            event.preventDefault();

            const formData = new FormData(form);

            fetch('/Order/UpdateCartItem', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(result => {

                if (result.code === 0) {
                    // Hiển thị lỗi trong modal
                    const errorBox = document.getElementById("modal-error");
                    if (errorBox) {
                        errorBox.innerText = result.message;
                        errorBox.classList.remove("d-none");
                    } else {
                        alert(result.message);
                    }
                    return;
                }

                // Đóng modal Bootstrap 5
                const modalElement = document.getElementById('dialogModal');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                if (modalInstance) {
                    modalInstance.hide();
                }

                // Reload lại giỏ hàng
                showCart();

            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Không thể cập nhật giỏ hàng.');
            });
        }
        function createOrder(event, form) {
            event.preventDefault(); // chặn submit mặc định

            const formData = new FormData(form);

            fetch('/Order/CreateOrder', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(result => {

                if (result.code === 0) {
                    // Hiển thị lỗi
                    const errorBox = document.getElementById("order-error");
                    if (errorBox) {
                        errorBox.innerText = result.message;
                        errorBox.classList.remove("d-none");
                    } else {
                        alert(result.message);
                    }
                    return;
                }

                // Chuyển hướng đến trang chi tiết đơn hàng
                window.location.href = `/Order/Detail/${result.code}`;

            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Không thể tạo đơn hàng.');
            });
        }
    </script>
}