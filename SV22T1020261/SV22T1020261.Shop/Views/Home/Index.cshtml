@model ProductSearchInput
@{
    ViewBag.Title = "Trang chủ";
}
<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body p-4">
            <h5 class="card-title mb-3 fw-bold"><i class="bi bi-filter-left"></i> Bộ lọc tìm kiếm</h5>
            <form class="row g-3"
                  id="formSearch"
                  method="get"
                  action="~/Home/Search"
                  data-target="searchResult"
                  onsubmit="paginationSearch(event, this, 1)">
                  
                <input type="hidden" asp-for="PageSize" />

                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="floatingInput" placeholder="Tên sản phẩm..." asp-for="SearchValue">
                        <label for="floatingInput">Tên sản phẩm</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <select class="form-select" id="floatingSelect"
                                asp-for="CategoryID"
                                asp-items="await SelectListHelper.Categories()">
                        </select>
                        <label for="floatingSelect">Loại hàng</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text"
                                asp-for="MinPrice"
                                class="form-control money-input"
                                placeholder="Từ" />
                        <label for="priceFrom">Giá từ (VNĐ)</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text"
                               asp-for="MaxPrice"
                               class="form-control money-input"
                               placeholder="Đến" />
                        <label for="priceTo">Đến giá (VNĐ)</label>
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary rounded-3 fw-bold">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>
    
       
    <div id="searchResult"></div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("formSearch"), @Model.Page);
        });
    </script>
}