@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="bi bi-cart3"></i> Giỏ hàng của bạn</h2>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 p-3">Sản phẩm</th>
                                <th class="border-0 p-3 text-center">Đơn giá</th>
                                <th class="border-0 p-3 text-center">Số lượng</th>
                                <th class="border-0 p-3 text-center">Thành tiền</th>
                                <th class="border-0 p-3 text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="p-3">
                                    <div class="d-flex align-items-center">
                                        <img src="https://picsum.photos/id/1/80/80" class="rounded-3 me-3" alt="Product">
                                        <div>
                                            <h6 class="fw-bold mb-0">MacBook Air M3</h6>
                                            <small class="text-muted">Laptop</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-3 text-center text-primary fw-bold">28.990.000đ</td>
                                <td class="p-3 text-center" style="min-width: 150px;">
                                    <div class="input-group input-group-sm justify-content-center">
                                        <button class="btn btn-outline-secondary rounded-start-3" type="button">-</button>
                                        <input type="text" class="form-control text-center border-secondary" value="1" style="max-width: 50px;">
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button">+</button>
                                    </div>
                                </td>
                                <td class="p-3 text-center fw-bold text-dark">28.990.000đ</td>
                                <td class="p-3 text-center">
                                    <button class="btn btn-outline-danger btn-sm border-0" title="Xóa mặt hàng">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td class="p-3">
                                    <div class="d-flex align-items-center">
                                        <img src="https://picsum.photos/id/160/80/80" class="rounded-3 me-3" alt="Product">
                                        <div>
                                            <h6 class="fw-bold mb-0">iPhone 15 Pro</h6>
                                            <small class="text-muted">Điện thoại</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-3 text-center text-primary fw-bold">25.500.000đ</td>
                                <td class="p-3 text-center">
                                    <div class="input-group input-group-sm justify-content-center">
                                        <button class="btn btn-outline-secondary rounded-start-3" type="button">-</button>
                                        <input type="text" class="form-control text-center border-secondary" value="1" style="max-width: 50px;">
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button">+</button>
                                    </div>
                                </td>
                                <td class="p-3 text-center fw-bold text-dark">25.500.000đ</td>
                                <td class="p-3 text-center">
                                    <button class="btn btn-outline-danger btn-sm border-0">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer bg-white p-3 border-0 border-top">
                    <button class="btn btn-link text-danger text-decoration-none btn-sm fw-bold">
                        <i class="bi bi-x-circle"></i> Xoá toàn bộ giỏ hàng
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-2">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Thông tin đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">54.490.000đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-bold">Miễn phí</span>
                    </div>
                    <hr class="my-4 border-dashed">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Tổng cộng:</span>
                        <span class="fs-4 fw-bolder text-primary">54.490.000đ</span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg rounded-3 fw-bold">
                            <i class="bi bi-credit-card"></i> THANH TOÁN NGAY
                        </button>
                    </div>
                    
                    <div class="mt-4 p-3 bg-light rounded-3">
                        <p class="small text-muted mb-0">
                            <i class="bi bi-shield-check"></i> Cam kết bảo mật thông tin thanh toán của khách hàng.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>