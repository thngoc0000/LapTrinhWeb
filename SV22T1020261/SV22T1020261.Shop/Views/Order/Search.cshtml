@model PagedResult<OrderViewInfo>
@{
    Layout = null;

    bool kt = false;
}
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 text-muted fw-bold small text-uppercase">Mã đơn hàng</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase">Thời gian đặt</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase">Thời gian hoàn thành</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase">Người giao hàng</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase">Địa chỉ giao</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase">Thành tiền</th>
                    <th class="py-3 text-muted fw-bold small text-uppercase text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.DataItems)
                {
                    if (order.FinishedTime == null)
                    {
                        continue;
                    }
                    kt = true;
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-dark">#@order.OrderID</span>
                        </td>
                        <td>
                            <div class="small">@order.OrderTime.ToString("dd/MM/yyyy")</div>
                            <div class="text-muted min-small" style="font-size: 0.75rem;">@order.OrderTime.ToString("hh:mm")</div>
                        </td>
                        <td>
                            <div class="small text-success fw-medium">@(order.FinishedTime != null ? order.FinishedTime.Value.ToString("dd/MM/yyyy"): "")</div>
                            <div class="text-muted min-small" style="font-size: 0.75rem;">@(order.FinishedTime != null ? order.FinishedTime.Value.ToString("hh:mm") : "")</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                    <i class="bi bi-person-badge text-secondary"></i>
                                </div>
                                <span class="small">@order.ShipperName</span>
                            </div>
                        </td>
                        <td>
                            <p class="small mb-0 text-truncate" style="max-width: 150px;">
                                @order.DeliveryAddress<strong>@(order.DeliveryProvince != null ? ", " + order.DeliveryProvince : "")</strong>
                            </p>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">@order.TotalAmount.ToString("N0") đ</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@order.OrderID" class="btn btn-sm btn-primary rounded-pill px-3">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                }
                @if(kt == false)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mb-0 mt-2">Không có đơn hàng nào đã hoàn thành.</p>
                        </td>
                    </tr>
                }                
            </tbody>
        </table>
    </div>
        
    
    <div class="card-footer">
        <ul class="pagination justify-content-center">
            @foreach (var p in Model.GetDisplayPages())
            {
                if (p.IsCurrent)
                {
                    <li class="page-item active">
                        <a class="page-link">@p.Page</a>
                    </li>
                }
                else if (p.IsEllipsis)
                {
                    <li class="page-item">
                        <a class="page-link">...</a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:;"
                               onclick="paginationSearch(event, document.getElementById('formSearch'), @p.Page)">
                            @p.Page
                        </a>
                    </li>
                }
            }
        </ul>
    </div>
</div>