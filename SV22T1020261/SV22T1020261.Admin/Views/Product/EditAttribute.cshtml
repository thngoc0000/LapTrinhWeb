@model ProductAttribute

@section PageToolBar {
    <button type="submit" form="formEdit" class="btn btn-primary">
        <i class="bi bi-save"></i>
        Lưu thuộc tính
    </button>

    <a href="~/Product/Edit/@Model.ProductID#attributes"
           class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-outline card-success">
            <div class="card-header">
                <h5 class="mb-0">Thông tin thuộc tính</h5>
            </div>

            <div class="card-body">

                <form id="formEdit" method="post"
                      action="~/Product/SaveAttribute">

                    <input type="hidden" asp-for="AttributeID" />
                    <input type="hidden" asp-for="ProductID" />

                    <div class="row mb-3">
                        <label class="col-sm-3">Tên thuộc tính</label>
                        <div class="col-sm-9">
                            <input asp-for="AttributeName"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3">Giá trị</label>
                        <div class="col-sm-9">
                            <input asp-for="AttributeValue"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3">Thứ tự hiển thị</label>
                        <div class="col-sm-3">
                            <input asp-for="DisplayOrder"
                                   type="number"
                                   class="form-control" />
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>