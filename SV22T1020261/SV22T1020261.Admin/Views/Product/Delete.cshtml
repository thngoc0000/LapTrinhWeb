@model Product
@{
    ViewBag.Title = "Xóa mặt hàng";
}

@section PageToolBar {

    @if (ViewBag.CanDelete)
    {
        <button type="submit" form="formDelete" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>
            Xóa
        </button>
    }

    <a href="~/Product" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @(ViewBag.CanDelete ? "Xác nhận xóa mặt hàng" : "Thông báo")
                </h5>
            </div>

            <div class="card-body">

                <form id="formDelete" method="post"
                      action="~/Product/Delete/@Model.ProductID">

                    @if (ViewBag.CanDelete)
                    {
                        <div class="alert alert-warning">
                            Bạn có chắc chắn muốn xóa mặt hàng này không?
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            Không thể xóa vì mặt hàng đã phát sinh dữ liệu liên quan.
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-8">
                            <dl class="row mb-0">

                                <dt class="col-sm-4">Tên mặt hàng</dt>
                                <dd class="col-sm-8">@Model.ProductName</dd>

                                @* <dt class="col-sm-4">Loại hàng</dt>
                                <dd class="col-sm-8">@Model.CategoryName</dd>

                                <dt class="col-sm-4">Nhà cung cấp</dt>
                                <dd class="col-sm-8">@Model.SupplierName</dd> *@

                                <dt class="col-sm-4">Đơn vị tính</dt>
                                <dd class="col-sm-8">@Model.Unit</dd>

                                <dt class="col-sm-4">Giá</dt>
                                <dd class="col-sm-8">
                                    @Model.Price.ToString("N0") đ
                                </dd>

                                <dt class="col-sm-4">Trạng thái</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(Model.IsSelling ? "bg-success" : "bg-secondary")">
                                        @(Model.IsSelling ? "Đang bán" : "Ngừng bán")
                                    </span>
                                </dd>

                                @* <dt class="col-sm-4">Mô tả</dt>
                                <dd class="col-sm-8">@Model.Description</dd> *@

                            </dl>
                        </div>

                        <div class="col-md-4 text-end">
                            <img src="@(string.IsNullOrEmpty(Model.Photo) ? "/images/products/nophoto.png" : "/images/products/" + Model.Photo)"
                                 class="img-fluid img-thumbnail"
                                 style="max-height:220px;" />
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>