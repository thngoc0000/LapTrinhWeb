@model Customer
@{
    ViewBag.Title = "Hồ sơ cá nhân";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex align-items-center mb-4">
                <div class="position-relative">
                    <img src=@("https://ui-avatars.com/api/?name=" + @Model.CustomerName)
                         class="rounded-circle shadow-sm border border-4 border-white" alt="Avatar">
                </div>
                <div class="ms-4">
                    <h2 class="fw-bold mb-1 text-dark">@Model.CustomerName</h2>
                    <p class="text-muted mb-0">
                        <i class="bi bi-geo-alt-fill me-1"></i> @Model.Province
                    </p>
                    <span class="badge bg-primary-subtle text-primary mt-2 px-3">
                        Khách hàng thân thiết
                    </span>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0 text-dark">Thông tin cá nhân</h5>
                    <a href="~/Account/EditProfile"
                           class="btn btn-outline-primary btn-sm rounded-3 px-3">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase">Họ và Tên</label>
                            <input class="form-control form-control-lg border-0 bg-light rounded-3"
                                   asp-for="CustomerName" readonly>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase">Số điện thoại</label>
                            <input class="form-control form-control-lg border-0 bg-light rounded-3"
                                   asp-for="Phone" readonly>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase">Tỉnh / Thành phố</label>
                            <input class="form-control form-control-lg border-0 bg-light rounded-3"
                                   asp-for="Province" readonly>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase">Địa chỉ cụ thể</label>
                            <textarea class="form-control form-control-lg border-0 bg-light rounded-3"
                                      asp-for="Address" readonly></textarea>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>