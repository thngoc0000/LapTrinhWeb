@{
    ViewBag.Title = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h4 class="fw-bold text-center mb-3">Quên mật khẩu</h4>

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <strong>Mật khẩu mới của bạn:</strong><br />
                            <span class="fw-bold text-danger">@ViewBag.NewPassword</span>
                            <br />
                            Vui lòng đăng nhập và đổi lại mật khẩu ngay.
                        </div>
                    }
                    else
                    {
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label">Nhập số điện thoại đã đăng ký</label>
                                <input type="tel"
                                       name="Phone"
                                       class="form-control"
                                       placeholder="0123321123" />
                                @Html.ValidationMessage("Phone", "", new { @class = "text-danger small" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Đặt lại mật khẩu
                            </button>
                        </form>
                    }

                </div>
            </div>

        </div>
    </div>
</div>