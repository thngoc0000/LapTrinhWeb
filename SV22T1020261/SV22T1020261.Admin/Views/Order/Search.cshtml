@using SV22T1020261.BusinessLayers
@model PagedResult<OrderViewInfo>
@{
    Layout = null;
}

<div class="mb-2 text-muted">
    Danh sách này có <strong>@Model.RowCount</strong> đơn hàng
</div>

<div class="card">
    <div class="card-body p-1">
        <table class="table table-bordered table-hover mb-0 align-middle">
            <thead class="table-secondary">
                <tr>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Điện thoại</th>
                    <th>Ngày duyệt</th>
                    <th>Nhân viên xử lý</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center" style="width:140px;">Trạng thái</th>
                    <th class="text-center" style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DataItems != null && Model.DataItems.Count > 0)
                {
                    foreach (var item in Model.DataItems)
                    {
                        <tr>
                            <td>@item.OrderTime.ToString("dd/MM/yyyy")</td>
                            <td>@item.CustomerName</td>
                            <td>@item.CustomerPhone</td>
                            <td>@(item.AcceptTime?.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>@item.EmployeeName</td>

                            @* Sử dụng tạm thời *@
                            @* <td class="text-end">@(await SalesDataService.GetTotalAmountAsync(item.OrderID))</td> *@
                            <td class="text-end">@item.TotalAmount.ToString("N0") đ</td>

                            <td class="text-center">
                                @switch (item.Status)
                                {
                                    case OrderStatusEnum.New:
                                        <span class="badge bg-secondary">Chờ duyệt</span>
                                        break;
                                            
                                    case OrderStatusEnum.Accepted:
                                        <span class="badge bg-info">Đã duyệt</span>
                                        break;

                                    case OrderStatusEnum.Shipping:
                                        <span class="badge bg-primary">Đang giao</span>
                                        break;

                                    case OrderStatusEnum.Completed:
                                        <span class="badge bg-success">Hoàn thành</span>
                                        break;

                                    case OrderStatusEnum.Cancelled:
                                        <span class="badge bg-danger">Đã huỷ</span>
                                        break;

                                    case OrderStatusEnum.Rejected:
                                        <span class="badge bg-dark">Từ chối</span>
                                        break;
                                }
                            </td>

                            <td class="text-center text-nowrap">
                                <a href="~/Order/Detail/@item.OrderID" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            Không có dữ liệu
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    @* <div class="card-footer">
        <ul class="pagination justify-content-center mb-0">

            @for (int p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <li class="page-item active">
                        <a class="page-link">@p</a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                               href="javascript:;"
                               onclick="paginationSearch(event, document.getElementById('formSearch'), @p)">
                            @p
                        </a>
                    </li>
                }
            }

        </ul>
    </div> *@
    <div class="card-footer">
        <ul class="pagination justify-content-center">
            @foreach (var p in Model.GetDisplayPages())
            {
                if (p.IsCurrent)
                {
                    <li class="page-item active">
                        <a class="page-link">@p.Page</a>
                    </li>
                }
                else if (p.IsEllipsis)
                {
                    <li class="page-item">
                        <a class="page-link">...</a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:;"
                               onclick="paginationSearch(event, document.getElementById('formSearch'), @p.Page)">
                            @p.Page
                        </a>
                    </li>
                }
            }
        </ul>
    </div>
</div>