@model Employee
@{
    ViewBag.Title = "Phân quyền nhân viên";
    // Ép kiểu dữ liệu từ ViewBag
    var currentRoles = ViewBag.CurrentRoles as List<string> ?? new List<string>();
    
    var message = ViewBag.Message as string;
}

@section PageToolBar {
    <button type="submit" form="formChangeRole" class="btn btn-primary">
        <i class="bi bi-shield-check me-1"></i>
        Lưu phân quyền
    </button>
    <a href="~/Employee" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-shield-check me-2"></i>
                    Phân quyền cho nhân viên
                </h5>
            </div>
            @if(message != null)
            {
                <div class="alert alert-success m-3">
                    @message
                </div>
            }
            <div class="card-body">
                <form id="formChangeRole" method="post" action="~/Employee/ChangeRole">
                    @* Giữ ID nhân viên để submit *@
                    <input type="hidden" asp-for="EmployeeID" />

                    <fieldset class="mb-4">
                        <legend class="fs-6 text-muted mb-3">
                            <i class="bi bi-person me-1"></i>
                            Thông tin nhân viên
                        </legend>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Họ và tên</dt>
                            <dd class="col-sm-9">@Model.FullName</dd>

                            <dt class="col-sm-3">Email</dt>
                            <dd class="col-sm-9">@Model.Email</dd>

                            <dt class="col-sm-3">Trạng thái</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsWorking)
                                {
                                    <span class="badge bg-success">Đang làm việc</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã nghỉ việc</span>
                                }
                            </dd>
                        </dl>
                    </fieldset>

                    <fieldset>
                        <legend class="fs-6 text-muted mb-3">
                            <i class="bi bi-shield-lock me-1"></i>
                            Danh sách quyền
                        </legend>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-secondary">
                                    <tr>
                                        <th style="width:60px;" class="text-center">Chọn</th>
                                        <th>Tên quyền</th>
                                        <th>Mô tả quyền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Lưu ý: Phần danh sách quyền này thường sẽ lấy từ một danh sách riêng biệt 
                                       hoặc từ thuộc tính Roles của Model nếu có. Ở đây tôi giữ nguyên các hàng tĩnh 
                                       nhưng logic hiển thị thông tin nhân viên đã được cập nhật theo Model.
                                    *@                                    
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" name="roles"
                                                   value="@WebUserRoles.Administrator"
                                            @(currentRoles.Contains(WebUserRoles.Administrator) ? "checked" : "") />
                                        </td>
                                        <td>Quản trị hệ thống</td>
                                            <td>Quản lý người dùng, phân quyền, cấu hình hệ thống</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" name="roles"
                                                   value="@WebUserRoles.DataManager"
                                            @(currentRoles.Contains(WebUserRoles.DataManager) ? "checked" : "") />
                                        </td>
                                        <td>Quản lý dữ liệu</td>
                                        <td>Quản lý sản phẩm, mặt hàng, ...</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" name="roles"
                                                   value="@WebUserRoles.Sales"
                                            @(currentRoles.Contains(WebUserRoles.Sales) || currentRoles.Contains("employee") ? "checked" : "") />
                                        </td>
                                        <td>Quản lý bán hàng</td>
                                        <td>Tạo hoá đơn, tư vấn, bán hàng,...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </fieldset>

                </form>
            </div>
        </div>
    </div>
</div>